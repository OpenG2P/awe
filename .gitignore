# Helm package outputs (CI/local `helm package` lands .tgz at repo root)
/*.tgz

# ---------------------------------------------------------------------------
# Admin UI (Vite + React + TypeScript)
# ---------------------------------------------------------------------------
# Node deps + build outputs
ui/node_modules/
ui/dist/
ui/.vite/
ui/tsconfig.tsbuildinfo

# npm/yarn/pnpm debug logs
ui/npm-debug.log*
ui/yarn-debug.log*
ui/yarn-error.log*
ui/pnpm-debug.log*

# Vite local env overlays (beyond the generic `.env.*` above, scoped to ui/)
ui/*.local

# Built SPA bundle — produced by `npm run build` into the Python package so
# Docker picks it up. Never commit the compiled assets; build in CI instead.
src/awe/admin_ui/static/
